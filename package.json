{
  "name": "recaipt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "prebuild": "node scripts/check-node-version.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "duplicates": "jscpd",
    "check": "npm run typecheck && npm run lint && npm run duplicates",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/check-no-env-secrets.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^2.32.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "idb-keyval": "^6.3.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jscpd": "^5.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
